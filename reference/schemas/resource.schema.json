{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocki-app.github.io/saddle-website/schemas/resource.schema.json",
  "title": "SADDLE Resource core",
  "type": "object",
  "required": [
    "name"
  ],
  "oneOf": [
    {
      "required": [
        "path"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    },
    {
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "path"
        ]
      }
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "path": {
      "oneOf": [
        {
          "$ref": "#/$defs/localPath"
        },
        {
          "$ref": "#/$defs/remotePath"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localPath"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/remotePath"
          }
        }
      ]
    },
    "data": {
      "type": [
        "string",
        "array",
        "object"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "saddle": {
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "mediatype": {
      "type": "string"
    },
    "encoding": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "localPath": {
      "type": "string",
      "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f:]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f:]+)*$"
    },
    "remotePath": {
      "type": "string",
      "pattern": "^[hH][tT][tT][pP][sS]?://[^\\s]+$",
      "format": "uri"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/jsonValue"
    },
    {
      "if": {
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "string"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "format"
            ],
            "properties": {
              "format": {
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "mediatype"
            ],
            "properties": {
              "mediatype": {
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  ]
}
